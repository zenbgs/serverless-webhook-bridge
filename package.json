{
  "name": "serverless-webhook-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Reliable third-party webhook -> REST API integration on AWS Lambda, API Gateway, SQS, S3 and DynamoDB",
  "type": "module",
  "scripts": {
    "build": "esbuild src/ingest.ts src/worker.ts --bundle --platform=node --target=node22 --format=esm --out-extension:.js=.mjs --outdir=dist --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "uvx cfn-lint template.yaml"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
